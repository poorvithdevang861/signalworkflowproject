# ─────────────────────────────────────────────────────────────
# SignalWorkflow — Docker Environment Variables
# These override MDM_Backend/.env inside containers.
# Container names (db, redis, mailpit) are used instead of localhost.
# ─────────────────────────────────────────────────────────────

# Database (container name = db)
DATABASE_URL=postgresql://postgres:signalmdm2025@db:5432/SignalMDM

# Redis (container name = redis)
REDIS_URL=redis://redis:6379/0

# JWT / Security — values come from docker/.env.generated (created by ensure-secrets.sh)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
APP_ENV=development
UPLOAD_DIR=storage/uploads
INGESTION_PIPELINE_STAGE_DELAY_SECONDS=1

# ─────────────────────────────────────────────────────────────
# SMTP — Mailpit (local email testing)
# Mailpit Web UI: http://localhost:8025 (view captured emails)
# If Mailpit is down, backend falls back to logging OTP in
# console (docker compose logs backend).
# ─────────────────────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=signalworkflow@local.dev
SMTP_PASSWORD=anything
SMTP_FROM=signalworkflow@local.dev
SMTP_USE_TLS=false

# Google OAuth (optional) — same client ID for backend + frontend build
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3030
GOOGLE_CLIENT_ID=496882730228-4d97m98vap04qt8np6uucgidheooq6ed.apps.googleusercontent.com
FRONTEND_URL=http://localhost:3030
